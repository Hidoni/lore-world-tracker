{
  "name": "@lore/chronology",
  "version": "1.0.0",
  "private": true,
  "description": "Lore time engine: calendars, recurrence, correspondences, viewport/tick math (bigint-exact).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./presets": "./src/preset-library.ts",
    "./viewport": "./src/viewport/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.json",
    "gen:schema": "node scripts/gen-schema.ts",
    "check:schema": "node scripts/gen-schema.ts --check",
    "bench": "vitest bench --run",
    "build:exec": "node scripts/build-exec.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "^4.10.2",
    "json-schema-to-typescript": "^16.0.0",
    "rolldown": "^1.2.15",
    "vitest": "^5.0.5"
  }
}
