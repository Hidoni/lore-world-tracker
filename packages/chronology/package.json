{
  "name": "@lore/chronology",
  "version": "0.0.0",
  "private": true,
  "description": "Lore time engine: calendars, recurrence, correspondences, viewport/tick math (bigint-exact).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.json",
    "gen:schema": "node scripts/gen-schema.ts",
    "check:schema": "node scripts/gen-schema.ts --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "json-schema-to-typescript": "^16.0.0",
    "vitest": "^5.0.3"
  }
}
