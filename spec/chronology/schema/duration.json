{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "base": "#/$defs/BaseDuration",
      "calendar": "#/$defs/CalendarDuration"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/BaseDuration"
    },
    {
      "$ref": "#/$defs/CalendarDuration"
    }
  ],
  "title": "Duration",
  "$defs": {
    "BaseDuration": {
      "additionalProperties": false,
      "description": "An exact, signed number of base units.",
      "properties": {
        "kind": {
          "const": "base",
          "type": "string"
        },
        "units": {
          "maxLength": 1001,
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "units"
      ],
      "title": "BaseDuration",
      "type": "object"
    },
    "CalendarDuration": {
      "additionalProperties": false,
      "description": "Amounts of calendar units, applied by calendar arithmetic (chronology-engine §9).",
      "properties": {
        "kind": {
          "const": "calendar",
          "type": "string"
        },
        "calendar_id": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "amounts": {
          "maxProperties": 20,
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "maxLength": 1000,
              "pattern": "^(0|[1-9][0-9]*)$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 64
          },
          "type": "object"
        },
        "sign": {
          "enum": [
            1,
            -1
          ],
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "calendar_id",
        "amounts",
        "sign"
      ],
      "title": "CalendarDuration",
      "type": "object"
    }
  }
}
