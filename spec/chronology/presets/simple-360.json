{
  "id": "simple-360",
  "name": "360-day",
  "description": "Twelve numbered months of 30 days (360 days a year, no leap years), shown as year-month-day. Astronomical years, no eras.",
  "origin": "the start of day 1 of month 1 of year 1",
  "requires": {
    "duration_seconds": "0"
  },
  "definition": {
    "schema_version": 1,
    "levels": [
      {
        "id": "second",
        "label": "second",
        "plural": "seconds",
        "abbr": "s",
        "numbering_start": 0,
        "default_template": "second"
      },
      {
        "id": "minute",
        "label": "minute",
        "plural": "minutes",
        "abbr": "min",
        "numbering_start": 0,
        "default_template": "minute"
      },
      {
        "id": "hour",
        "label": "hour",
        "plural": "hours",
        "abbr": "h",
        "numbering_start": 0,
        "default_template": "hour"
      },
      {
        "id": "day",
        "label": "day",
        "plural": "days",
        "abbr": "d",
        "numbering_start": 1,
        "default_template": "day"
      },
      {
        "id": "month",
        "label": "month",
        "plural": "months",
        "abbr": "mo",
        "numbering_start": 1,
        "default_template": "m30"
      },
      {
        "id": "year",
        "label": "year",
        "plural": "years",
        "abbr": "y"
      }
    ],
    "regimes": [
      {
        "id": "simple",
        "name": "360-day",
        "templates": {
          "second": {
            "level": "second",
            "uniform": {
              "count": "1"
            }
          },
          "minute": {
            "level": "minute",
            "uniform": {
              "count": "60"
            }
          },
          "hour": {
            "level": "hour",
            "uniform": {
              "count": "60"
            }
          },
          "day": {
            "level": "day",
            "uniform": {
              "count": "24"
            }
          },
          "m30": {
            "level": "month",
            "uniform": {
              "count": "30"
            }
          },
          "year": {
            "level": "year",
            "uniform": {
              "count": "12"
            }
          }
        },
        "top": {
          "pattern": {
            "kind": "fixed",
            "template": "year"
          }
        },
        "alignment": {
          "fields": {
            "year": "1",
            "month": "1",
            "day": "1"
          },
          "at": {
            "anchor": {
              "kind": "absolute",
              "t": "0"
            },
            "precision": "base"
          }
        }
      }
    ],
    "formats": {
      "year": "{year}",
      "month": "{year}-{month:pad2}",
      "day": "{year}-{month:pad2}-{day:pad2}",
      "hour": "{year}-{month:pad2}-{day:pad2} {hour:pad2} h",
      "minute": "{year}-{month:pad2}-{day:pad2} {hour:pad2}:{minute:pad2}",
      "second": "{year}-{month:pad2}-{day:pad2} {hour:pad2}:{minute:pad2}:{second:pad2}"
    }
  }
}
