# Local data: vaults (`make dev` uses ./data; `lore serve` from backend/ defaults to backend/data),
# published reader sites, SQLite files. Anchored so frontend/src/data stays tracked.
/data/
/backend/data/
/published/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
!**/fixtures/**/*.db

# Environment and editors
.env
.env.*
.DS_Store
.idea/
.vscode/
.claude/settings.local.json
.claude/worktrees/
